# Persistent local path for SQLite. Default: ./data
# For a persistent Node server, set an absolute path on its durable disk.
# DATA_DIR=/absolute/path/to/learning-data

# Required in production for question-bank writes and audit exports.
# Use the public origin, including scheme and port when applicable.
# APP_ORIGIN=https://practice.example.com
# For a local production build, e.g. APP_ORIGIN=http://localhost:3000

# Set only behind a trusted proxy that overwrites this header with one client IP.
# The Node server must be reachable only through that proxy.
# AUTH_CLIENT_IP_HEADER=X-Real-IP
